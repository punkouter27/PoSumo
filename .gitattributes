# Same line-ending rule in every Po repo: text is stored with LF and checked out native; binaries are left alone.
* text=auto
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated by the MCP plugin with LF endings; pin them so regeneration does not show as 83 modified files.
.claude/skills/** text eol=lf
